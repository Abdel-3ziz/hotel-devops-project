pipeline {
  agent any

  environment {
    REGISTRY   = "localhost:5000"
    APP_NAME   = "hotel-app"
    IMAGE_TAG  = "${BUILD_NUMBER}-${GIT_COMMIT.take(7)}"
    FULL_IMAGE = "${REGISTRY}/${APP_NAME}:${IMAGE_TAG}"
  }

  stages {
    stage('Checkout') {
      steps { checkout scm }
    }

    stage('Build Image') {
      steps {
        dir('Hotel') {
          sh 'docker build -t $FULL_IMAGE .'
        }
      }
    }

    stage('Push to Local Registry') {
      steps {
        sh 'docker push $FULL_IMAGE'
      }
    }

    stage('Deploy to K8s') {
      steps {
        dir('Hotel') {
          sh '''
            # apply manifests (secrets/svc/deploy)
            kubectl apply -f k8s/

            # update deployment image to the new tag
            kubectl set image deploy/hotel-app hotel-app=$FULL_IMAGE

            kubectl rollout status deploy/hotel-app --timeout=180s
            kubectl get pods -o wide
            kubectl get svc -o wide || true
          '''
        }
      }
    }
  }
}
