pipeline {
  agent any

  environment {
    // Push from inside Jenkins network (dind)
    PUSH_REGISTRY = "registry:5000"

    // Pull from Docker Desktop Kubernetes
    K8S_REGISTRY  = "localhost:5000"

    APP_NAME   = "hotel-app"
    IMAGE_TAG  = "${BUILD_NUMBER}-${GIT_COMMIT.take(7)}"

    PUSH_IMAGE = "${PUSH_REGISTRY}/${APP_NAME}:${IMAGE_TAG}"
    K8S_IMAGE  = "${K8S_REGISTRY}/${APP_NAME}:${IMAGE_TAG}"
  }

  stages {
    stage('Checkout') {
      steps { checkout scm }
    }

    stage('Build Image') {
      steps {
        dir('Hotel') {
          sh '''
            set -eux
            docker build -t "$PUSH_IMAGE" .
          '''
        }
      }
    }

    stage('Push to Registry (once)') {
      steps {
        sh '''
          set -eux
          docker push "$PUSH_IMAGE"
        '''
      }
    }

    stage('Deploy to K8s') {
      steps {
        dir('Hotel') {
          sh '''
            set -eux

            # Apply manifests without fetching OpenAPI schema (avoids auth/redirect validation error)
            kubectl apply -f k8s/ --validate=false

            # Update deployment image
            kubectl set image deploy/hotel-app hotel-app="$K8S_IMAGE"

            # Wait rollout & show status
            kubectl rollout status deploy/hotel-app --timeout=180s
            kubectl get pods -o wide
          '''
        }
      }
    }
  }

  post {
    always {
      sh '''
        kubectl get deploy -o wide 2>/dev/null || true
        kubectl get pods -o wide 2>/dev/null || true
      '''
    }
  }
}
